# Set to true to load the "Vehículos usados" demo list when storage is empty (off by default)
EXPO_PUBLIC_ENABLE_DEMO_SEED=false

# Botones "Buscar en Amazon / Mercado Libre". Vacíos: la búsqueda funciona pero sin comisión.
# Tag de Amazon Associates (p. ej. ponderank-20) y dominio de la tienda (por defecto amazon.com)
EXPO_PUBLIC_AMAZON_TAG=
EXPO_PUBLIC_AMAZON_DOMAIN=
# Dominio de Mercado Libre del país (por defecto mercadolibre.com.co) y parámetros de afiliado
# tal como los entrega el portal de afiliados, en formato clave=valor&clave2=valor2
EXPO_PUBLIC_MELI_DOMAIN=
EXPO_PUBLIC_MELI_AFFILIATE_QUERY=
